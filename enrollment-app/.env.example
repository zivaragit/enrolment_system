# ──────────────────────────────────────────────────────────────
# Firebase Web App configuration
# Copy this file to `.env` and fill in values from:
#   Firebase Console → Project Settings → Your apps → Web app → SDK setup
# ──────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# ──────────────────────────────────────────────────────────────
# Local development against the Firebase Emulator Suite.
# Set to "true" to point the app at local emulators (no real project needed).
# Start emulators with:  npm run emulators
# ──────────────────────────────────────────────────────────────
VITE_USE_EMULATOR=false

# Emulator host/ports (only used when VITE_USE_EMULATOR=true).
# Defaults match firebase.json. Override if those ports are taken on your machine.
VITE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_PORT=9099

# Block a second enrollment with the same email/phone (FR-1.4)
VITE_BLOCK_DUPLICATES=true
